# Full LinkUp-style runtime. Copy to .env when using Compose.
APP_MODE=production
DATABASE_URL=postgresql+psycopg://keykeep:keykeep@localhost:5432/keykeep
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# false for localhost HTTP; true behind HTTPS
REFRESH_COOKIE_SECURE=false
DEBUG=false
SQL_ECHO=false
